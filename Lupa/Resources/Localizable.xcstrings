      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$lld"
          }
        }
      },
      "shouldTranslate": false
    },
    "%@. Hottest point: %@. Up to about 95 °C under load is normal for M chips.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@. Hottest point: %2$@. Up to about 95 °C under load is normal for M chips."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Ponto mais quente: %@. Até uns 95 °C sob carga é normal para chips M."
          }
        }
      }
    },
    "%@. The app moves to the Trash, where you can restore it.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. O app vai para o Lixo e pode ser recuperado de lá."
          }
        }
      }
    },
    "%@: needs an administrator password, and the operation was canceled or not authorized.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: precisa da senha de administrador, e a operação foi cancelada ou não foi autorizada."
          }
        }
      }
    },
    "%lld apps": {
      "localizations": {
