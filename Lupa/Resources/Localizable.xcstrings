      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Move o app para o Lixo. Você confirma antes e pode recuperar. Preferências e caches em ~/Library ficam."
          }
        }
      }
    },
    "Music and the Music app library.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Músicas e a biblioteca do app Música."
