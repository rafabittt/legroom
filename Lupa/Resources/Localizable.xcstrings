        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa uma ferramenta do macOS"
          }
        }
      }
    },
    "Runs only on this Mac. Nothing is sent anywhere, and nothing changes unless you ask.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Roda só neste Mac. Nada é enviado para fora, e nada muda sem você pedir."
