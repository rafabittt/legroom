      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativar…"
          }
        }
      }
    },
    "Turn it back on in Privacy & Security, under “Allow applications from”.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Religue em Privacidade e Segurança, em “Permitir aplicativos de”."
          }
