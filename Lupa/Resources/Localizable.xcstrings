        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pacotes do gerenciador Nix."
          }
        }
      }
    },
    "Per-user caches and temporary files. The system recreates what it needs; deleting by hand is rarely worth it.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches e temporários por usuário. O sistema recria o que precisar; apagar à mão raramente compensa."
          }
