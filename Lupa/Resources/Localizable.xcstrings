        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pacotes e arquivos de projeto"
          }
        }
      }
    },
    "Packages downloaded by npm, pnpm, yarn, bun, Gradle, Cargo, Maven, CocoaPods, and Homebrew. Everything is downloaded again when a project needs it.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
