    "Size": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamanho"
          }
        }
      }
    },
    "Sizes always show the space allocated on disk (what you get back as free space when you delete). The logical size appears in the details panel.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamanhos são sempre o espaço alocado em disco (o que volta como espaço livre ao apagar). O tamanho lógico aparece no painel de detalhes."
          }
        }
      }
    },
    "Some folders couldn't be read": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas pastas não puderam ser lidas"
          }
        }
      }
    },
    "Suggested: unchanged for %lld days; the app recreates it if needed.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugerido: nada alterado há %lld dias; o app recria se precisar."
          }
        }
      }
    },
    "Suggested: unchanged for 1 day; the app recreates it if needed.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugerido: nada alterado há 1 dia; o app recria se precisar."
          }
