{
  "sourceLanguage": "en",
  "strings": {
    "": {
      "shouldTranslate": false
    },
    " To uninstall, use the Apps screen in Legroom.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Para desinstalar, use a tela Apps do Legroom."
          }
        }
      }
    },
    " and %lld more.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " e mais %lld."
          }
        }
      }
    },
    "%": {
      "shouldTranslate": false
    },
    "% CPU": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "% do processador"
          }
        }
      }
    },
    "%@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@"
          }
        }
      },
      "shouldTranslate": false
    },
    "%@ and %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ and %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ e %@"
          }
        }
      }
    },
    "%@ files · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ files · %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ arquivos · %@"
          }
        }
      }
    },
    "%@ free": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ livre"
          }
        }
      }
    },
    "%@ free of %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ free of %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ livres de %@"
          }
        }
      }
    },
    "%@ in %@ files. Nothing is permanently deleted: you can restore them from the Trash.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ in %2$@ files. Nothing is permanently deleted: you can restore them from the Trash."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ em %@ arquivos. Nada é apagado permanentemente: você pode recuperar no Lixo."
          }
        }
      }
    },
    "%@ in %lld items": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ in %2$lld items"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ em %lld itens"
          }
        }
      }
    },
    "%@ in %lld items moved to the Trash": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ in %2$lld items moved to the Trash"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ em %lld itens movidos para o Lixo"
          }
        }
      }
    },
    "%@ in 1 file. Nothing is permanently deleted: you can restore it from the Trash.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ em 1 arquivo. Nada é apagado permanentemente: você pode recuperar no Lixo."
          }
        }
      }
    },
    "%@ is open and will be quit first.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está aberto e será fechado antes."
          }
        }
      }
    },
    "%@ is using %@%% of the CPU. Asks the app to quit, like ⌘Q.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is using %2$@%% of the CPU. Asks the app to quit, like ⌘Q."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está usando %@%% do processador. Pede para o app sair, como ⌘Q."
          }
        }
      }
    },
    "%@ items in %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ items in %2$@"
          }
