    "Everything you move to the Trash with Legroom adds up here.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que você mover para o Lixo pelo Legroom aparece somado aqui."
          }
        }
      }
    },
    "Explanation generated by Apple Intelligence on this Mac. It can be wrong: check before moving.\n\n%@\n\n%@: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Explanation generated by Apple Intelligence on this Mac. It can be wrong: check before moving.\n\n%1$@\n\n%2$@: %3$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Explicação gerada pelo Apple Intelligence neste Mac. Pode errar: confira antes de mover.\n\n%@\n\n%@: %@"
          }
        }
      }
    },
    "Figuring out what this item is…": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensando no que é este item…"
          }
        }
      }
    },
    "File": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivo"
          }
        }
      }
    },
    "FileVault": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "FileVault"
          }
        }
      }
    },
    "Files": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos"
          }
        }
      }
    },
    "Files of 1 MB or larger in your home folder, outside Library.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos a partir de 1 MB nas pastas da sua pasta pessoal, fora da Biblioteca."
          }
        }
      }
    },
    "Files of the same size are being compared byte by byte.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos de mesmo tamanho estão sendo comparados byte a byte."
          }
        }
      }
    },
    "Files with identical content (same size and same signature) in your folders, outside the Library. Choose which copies go to the Trash; one always stays.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos com conteúdo idêntico (mesmo tamanho e mesma assinatura) nas suas pastas, fora da Biblioteca. Escolha quais cópias vão para o Lixo; uma sempre fica."
          }
        }
      }
    },
    "Firewall": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Firewall"
          }
        }
      }
    },
    "Folder": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasta"
          }
        }
      }
    },
    "Folders": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastas"
          }
        }
      }
    },
    "Free Up Memory": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpar memória"
          }
        }
      }
    },
    "Free Up Memory asks the system for memory so it discards file caches, then gives it back right away. The gain lasts until apps need it again.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpar pede memória ao sistema para ele descartar cache de arquivos e devolve em seguida. O ganho dura até os apps voltarem a precisar."
          }
        }
      }
    },
    "Free space": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espaço livre"
          }
        }
      }
    },
    "Freed %@": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Liberou %@"
          }
        }
      }
    },
    "Freed by Legroom": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Liberado pelo Legroom"
          }
        }
      }
    },
    "Gatekeeper": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gatekeeper"
          }
        }
      }
    },
    "Getting full": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Começando a apertar"
          }
        }
      }
    },
    "Give Legroom Full Disk Access and scan again to see everything.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conceda Acesso Total ao Disco ao Legroom e analise de novo para ver tudo."
          }
        }
      }
    },
    "Go modules and binaries.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Módulos e binários do Go."
          }
        }
      }
    },
    "Go to Enclosing Folder": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltar à pasta acima"
          }
        }
      }
    },
    "Goals": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Objetivos"
          }
        }
      }
    },
    "Gradle caches and distributions.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches e distribuições do Gradle."
          }
        }
      }
    },
    "Hold for %@ seconds to start.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure por %@ segundos para começar."
          }
        }
      }
    },
    "Hold to Scan %@": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure para analisar %@"
          }
        }
      }
    },
    "Hold to start. Releasing early cancels.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure para começar. Soltar antes cancela."
          }
        }
      }
    },
    "Home": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasta Pessoal"
          }
        }
      }
    },
    "Home folders for each account on this Mac.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastas pessoais de cada conta deste Mac."
          }
        }
      }
    },
    "Homebrew packages. Run brew cleanup to delete old versions and downloads.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pacotes do Homebrew. Use brew cleanup para apagar versões antigas e downloads."
          }
        }
      }
    },
    "Hot: the Mac is slowing down": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quente: o Mac reduz o ritmo"
          }
        }
      }
    },
    "How is my Mac doing?": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como está meu Mac?"
          }
        }
      }
    },
    "How much space each app really takes, and which ones you haven't opened in a while.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto cada app pesa de verdade e quais você não abre há tempos."
          }
        }
      }
    },
    "I couldn't read the disk right now.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não consegui ler o disco agora."
          }
        }
      }
    },
    "I haven't scanned Cleanup yet. Do you want me to open Legroom there?": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não li a Limpeza. Quer que eu abra o Legroom nela?"
          }
        }
      }
    },
    "Identified developers": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenvolvedores identificados"
          }
        }
      }
    },
    "Idle": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponível"
          }
        }
      }
    },
    "Image": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagem"
          }
        }
      }
    },
    "In the last scan, %@, Legroom found %@ that are safe to move to the Trash, out of %@ possible.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "In the last scan, %1$@, Legroom found %2$@ that are safe to move to the Trash, out of %3$@ possible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na última leitura, %@, o Legroom achou %@ que dá para mover para o Lixo com segurança, de %@ possíveis."
          }
        }
      }
    },
    "In the last scan, %@, there was nothing to clean up.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na última leitura, %@, não havia nada para limpar."
          }
        }
      }
    },
    "In the last scan, %@, there were %@ possible, but nothing I'd select without you looking first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "In the last scan, %1$@, there were %2$@ possible, but nothing I'd select without you looking first."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na última leitura, %@, havia %@ possíveis, mas nada que eu marcaria sem você olhar antes."
          }
        }
      }
    },
    "Installed apps. Deleting an .app here doesn't remove the preferences, caches, and data it left in the Library.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicativos instalados. Apagar um .app daqui não remove preferências, caches e dados que ele deixou na Biblioteca."
          }
        }
      }
    },
    "Installers": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instaladores"
          }
        }
      }
    },
    "Installs Apple's security responses and XProtect updates as soon as they're released.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala as respostas de segurança da Apple e as atualizações do XProtect assim que saem."
          }
        }
      }
    },
    "Interface %@": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Interface %@"
          }
        }
      }
    },
    "Intermediate build results. Xcode rebuilds them the next time you open the project; it only costs time.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultados intermediários de compilação. O Xcode recompila na próxima vez que você abrir o projeto; só custa tempo."
          }
        }
      }
    },
    "Internal system data: temporary files, logs, and caches in var/folders.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados internos do sistema: temporários, logs e caches em var/folders."
          }
        }
      }
    },
    "Is anything running that shouldn't be?": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem algo rodando que não deveria?"
          }
        }
      }
    },
    "It can only be turned back on from macOS Recovery (csrutil enable).": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só dá para religar pela Recuperação do macOS (csrutil enable)."
          }
        }
      }
    },
    "It stops now and won't start again. Its file (%@) goes to the Trash; put it back and log in again to undo.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele para agora e não abre mais. O arquivo dele (%@) vai para o Lixo; para desfazer, devolva o arquivo e entre de novo na sua conta."
          }
        }
      }
    },
    "It's running low on space.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Está com pouco espaço."
          }
        }
      }
    },
    "It's starting to get tight.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Está começando a apertar."
          }
        }
      }
    },
    "Items": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Itens"
          }
        }
      }
    },
    "Items in Downloads unused for more than 90 days. Many were opened once and forgotten.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Itens em Downloads sem uso há mais de 90 dias. Boa parte foi aberta uma vez e esquecida."
          }
        }
      }
    },
    "Its file (%@) goes to the Trash; Finder will ask for an administrator password. It stops after the next restart; put the file back to undo.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo dele (%@) vai para o Lixo; o Finder vai pedir a senha de administrador. Ele para depois de reiniciar; para desfazer, devolva o arquivo."
          }
        }
      }
    },
    "Keep holding…": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue segurando…"
          }
        }
      }
    },
    "Keeps the system files of macOS read-only, even for apps with administrator rights.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém os arquivos do sistema só para leitura, mesmo para apps com permissão de administrador."
          }
        }
      }
    },
    "Kind": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipo"
          }
        }
      }
    },
    "Large & Forgotten": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grandes e esquecidos"
          }
        }
      }
    },
    "Large files you haven't opened in months. Decide what goes to the Trash.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos pesados que você não abre há meses. Decida o que vai para o Lixo."
          }
        }
      }
    },
    "Last Accessed": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Último acesso"
          }
        }
      }
    },
    "Last Opened": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Última abertura"
          }
        }
      }
    },
    "Last Used": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Último uso"
          }
        }
      }
    },
    "Last run %@, with %lld malware-family scanners.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Last run %1$@, with %2$lld malware-family scanners."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Última execução %@, com %lld verificadores de famílias de malware."
          }
        }
      }
    },
    "Latency": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Latência"
          }
        }
      }
    },
    "Launch agents and services, and who signed what they run. Something unsigned isn't necessarily bad — your own scripts look the same — but it's worth knowing what it is.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentes e serviços que abrem sozinhos, e quem assinou o que eles rodam. Algo sem assinatura não é necessariamente ruim — seus próprios scripts aparecem assim —, mas vale saber o que é."
          }
        }
      }
    },
    "Launch at login": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abertura automática"
          }
        }
      }
    },
    "Leftovers": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobras"
          }
        }
      }
    },
    "Legroom": {
      "shouldTranslate": false
    },
    "Legroom is open on Cleanup. Hold the button to scan.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abri o Legroom na Limpeza. Segure o botão para ler."
          }
        }
      }
    },
    "Legroom looks in /Applications and ~/Applications.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Legroom lê /Applications e ~/Applications."
          }
        }
      }
    },
    "Legroom scans the disk once and answers the questions in the sidebar. Nothing runs on its own: the scan starts only when you hold the button. Nothing is deleted unless you ask, and removed items go to the Trash.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Legroom lê o disco uma vez e responde às perguntas da barra lateral. Nada roda sozinho: a leitura só começa quando você segurar o botão. Nada é apagado sem você pedir, e remoções vão para o Lixo."
          }
        }
      }
    },
    "Legroom screen": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tela do Legroom"
          }
        }
      }
    },
    "Light": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Claro"
          }
        }
      }
    },
    "Link %lld Mb/s": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Link %lld Mb/s"
          }
        }
      }
    },
    "List": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista"
          }
        }
      }
    },
    "List Only": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só a lista"
          }
        }
      }
    },
    "Lists apps you haven't opened in three months, from what Spotlight already knows. Nothing is uninstalled.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista os apps que você não abre há três meses, pelo que o Spotlight já sabe. Nada é desinstalado."
          }
        }
      }
    },
    "Local Maven repository.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositório local do Maven."
          }
        }
      }
    },
    "Local backups made by Finder. Each one can be tens of GB. Before deleting, check in Finder › device › Manage Backups which one belongs to which device and date.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups locais feitos pelo Finder. Cada um pode ter dezenas de GB. Antes de apagar, confira em Finder › aparelho › Gerenciar Backups qual é de qual aparelho e data."
          }
        }
      }
    },
    "Local copies apps keep so they open faster. Deleting them is safe; apps recreate what they need, so the gain may be partial.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cópias locais que os apps guardam para abrir mais rápido. Apagar é seguro; os apps recriam o que precisarem, então o ganho pode ser parcial."
          }
        }
      }
    },
    "Location": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde"
          }
        }
      }
    },
    "Logical": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lógico"
          }
        }
      }
    },
    "Logs": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Logs"
          }
        }
      }
    },
    "Logs & crash reports": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registros e relatórios de falha"
          }
        }
      }
    },
    "Logs from your apps. Safe to delete.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Logs dos seus apps. Seguro apagar."
          }
        }
      }
    },
    "Looking for duplicates…": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Procurando duplicados…"
          }
        }
      }
    },
    "Looking for large files": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Procurando arquivos pesados"
          }
        }
      }
    },
    "Looking for the app's data, caches, and preferences…": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
