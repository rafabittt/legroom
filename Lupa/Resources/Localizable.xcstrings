    "Memory has room": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Memória folgada"
          }
        }
      }
    },
    "Memory that overflowed to disk. Zero is ideal; a few GB is normal under heavy use.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Memória que transbordou para o disco. Zero é o ideal; alguns GB são normais em uso pesado."
