            "state": "translated",
            "value": "Ligue em Privacidade e Segurança › FileVault."
          }
        }
      }
    },
    "Turn off “%@”?": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativar “%@”?"
          }
        }
      }
    },
    "Turn on Apple Intelligence in System Settings so Legroom can explain unfamiliar items.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Apple Intelligence nos Ajustes do Sistema para o Legroom explicar itens desconhecidos."
          }
        }
      }
    },
    "Turn on “Install Security Responses and system files” in Software Update › Automatic Updates.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligue “Instalar Respostas de Segurança e arquivos do sistema” em Atualização de Software › Atualizações Automáticas."
          }
        }
      }
    },
    "Uninstall": {
