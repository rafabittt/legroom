    },
    "One app hasn't been used in over three months: ": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um app está sem uso há mais de três meses: "
          }
        }
      }
    },
    "One folder per iOS version you've connected to Xcode. Keep only the versions for devices you still use; Xcode downloads them again if needed.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pasta por versão de iOS que já conectou ao Xcode. Fique só com as versões dos aparelhos que ainda usa; o Xcode baixa de novo se precisar."
          }
        }
      }
    },
    "Only opens apps that are signed and checked by Apple, unless you allow an exception.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só abre apps assinados e verificados pela Apple, a não ser que você libere uma exceção."
          }
        }
      }
    },
    "Only what the Mac recreates on its own, unchanged for days and not in use by an open app. The rest is up to you.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o que o Mac recria sozinho, sem alterações há dias e sem app aberto usando. O resto você decide."
          }
        }
      }
    },
