  "strings" : {
    "NSAppleEventsUsageDescription" : {
      "comment" : "Shown when Legroom first asks to control Finder",
      "extractionState" : "manual",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Legroom pede ao Finder para mover para o Lixo itens do sistema, como apps instalados por pacote. O Finder pede a sua senha de administrador; o Legroom não vê nem guarda a senha."
          }
        }
      }
    },
